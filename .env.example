# ---------------------------------------------------------------------------
# APEX CONTROL - frontend environment configuration
# Copy to `.env.local` and adapt. Only variables prefixed with VITE_ are
# exposed to the browser bundle - never put secrets in here.
# ---------------------------------------------------------------------------

# Base URL of the Python Flask control server running on the APEX Windows PC.
# Leave empty to boot the dashboard in DEMO mode (simulated PC data).
# VITE_API_URL=http://192.168.1.100:8080

# Force demo mode on/off. Defaults to "true" when VITE_API_URL is not set.
# VITE_DEMO_MODE=true

# Polling intervals (milliseconds) - can also be changed in the UI
# VITE_STATUS_POLL_MS=5000
# VITE_STATS_POLL_MS=2000
# VITE_MEDIA_POLL_MS=1000

# Timeout for a single API request in milliseconds
# VITE_API_TIMEOUT_MS=8000

# Dev-server only: where the /api proxy forwards requests to.
# APEX_API_TARGET=http://127.0.0.1:8080
